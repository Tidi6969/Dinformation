; DCAD Dinformation LISP data engine for AutoCAD 2022/2025 and GstarCAD 2027.
; Cursor sampling and tooltip rendering remain in the host adapter; recognition and data reading are LISP.
@@BOOTSTRAP@@

(vl-load-com)

(defun dcad-dinf-t (key / pair)
  (setq pair (assoc key *dcad-dinf-lang*))
  (if pair (cdr pair) key)
)

(defun dcad-dinf-label (key) (strcat (dcad-dinf-t key) ": "))
(defun dcad-dinf-one-line (value)
  (if (and value (= (type value) 'STR))
    (vl-string-translate (strcat (chr 13) (chr 10)) "  " value)
    "")
)
(defun dcad-dinf-xprefix (key) (strcat (dcad-dinf-t key) ": X="))

(defun dcad-dinf-hatch-style (idx)
  (nth idx (list (dcad-dinf-t "HatchNormal") (dcad-dinf-t "HatchOuter") (dcad-dinf-t "HatchIgnore")))
)

(defun dcad-dinf-curve-type (idx)
  (if (= idx 1) (dcad-dinf-t "WordSpline") (dcad-dinf-t "WordPolyline"))
)

(defun dcad-dinf-alignment-name (idx)
  (nth idx
    (list
      (dcad-dinf-t "AlignLeft") (dcad-dinf-t "AlignCenter") (dcad-dinf-t "AlignRight")
      (dcad-dinf-t "AlignAligned") (dcad-dinf-t "AlignMiddle") (dcad-dinf-t "AlignFit")
      (dcad-dinf-t "AlignTopLeft") (dcad-dinf-t "AlignTopCenter") (dcad-dinf-t "AlignTopRight")
      (dcad-dinf-t "AlignMiddleLeft") (dcad-dinf-t "AlignMiddleCenter") (dcad-dinf-t "AlignMiddleRight")
      (dcad-dinf-t "AlignBottomLeft") (dcad-dinf-t "AlignBottomCenter") (dcad-dinf-t "AlignBottomRight")
    )
  )
)

(defun dcad-dinf-dxf (ent i)
  (if (= (type ent) 'ename)
    (setq ent (entget ent)))
  (cdr (assoc i ent))
)

(defun dcad-dinf-toang (ang i)
  (if (= i 1)
    (* ang (/ 180 pi))
    (* ang (/ pi 180)))
)

  (defun dcad-dinf-dis (ent / obj laynm name st1 st2 st3 lst) 
    (setq obj (vlax-ename->vla-object ent))
    (setq laynm (strcat (dcad-dinf-label "LabelLayer") (dcad-dinf-dxf ent 8))
          name  (dcad-dinf-dxf ent 0)
    )
    (cond 
      ((= name "3DFACE")
       (setq lst (list (dcad-dinf-t "TypeFace3d") laynm))
      )
      ((= name "3DSOLID")
       (setq lst (list (dcad-dinf-t "TypeSolid3d") 
                       laynm
                       (strcat (dcad-dinf-label "VersionNumber") (itoa (dcad-dinf-dxf ent 70)))
                 )
       )
      )
      ((= name "ACAD_PROXY_ENTITY")
       (setq lst (list (dcad-dinf-t "TypeProxy") laynm))
      )
      ((= name "ARC")
       (Setq Cen (VLAX-SafeArray->List (VLAX-Variant-Value (VLA-Get-Center obj))))
       (Setq arc_x (car Cen))
       (setq arc_y (nth 1 Cen))
       (setq lst (list (dcad-dinf-t "TypeArc") 
                       laynm
                       (strcat (dcad-dinf-label "Radius") (rtos (vla-get-radius obj) 2 4))
                       (strcat (dcad-dinf-label "ArcAngle") 
                               (rtos (dcad-dinf-toang (vla-get-TotalAngle obj) 1) 2 3)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-label "StartAngle") 
                               (rtos (dcad-dinf-toang (vla-get-StartAngle obj) 1) 2 3)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-label "EndAngle") 
                               (rtos (dcad-dinf-toang (vla-get-EndAngle obj) 1) 2 3)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-label "ArcLength") 
                               (rtos (vla-get-ArcLength obj) 2 4)
                       )
                       (strcat (dcad-dinf-label "Area") (rtos (/ (vla-get-area obj)) 2 3) "")
                       (strcat (dcad-dinf-xprefix "Center") (rtos arc_x))
                       (strcat "     Y=" (rtos arc_y))
                 )
       )
      )
      ((= name "ATTDEF")
       (setq lst (list (dcad-dinf-t "TypeAttributeDefinition") 
                       laynm
                       (strcat (dcad-dinf-label "Tag") (vla-get-TagString obj))
                       (strcat (dcad-dinf-label "Prompt") (vla-get-PromptString obj))
                       (strcat (dcad-dinf-label "Default") (vla-get-TextString obj))
                       (strcat (dcad-dinf-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dcad-dinf-label "Rotation") 
                               (rtos (dcad-dinf-toang (vla-get-Rotation obj) 1) 2 3)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-label "Style") (vla-get-StyleName obj))
                 )
       )
      )
      ((= name "ATTRIB")
       (setq lst (list (dcad-dinf-t "TypeAttribute") 
                       laynm
                       (strcat (dcad-dinf-label "Tag") (vla-get-TagString obj))
                       (strcat (dcad-dinf-label "Value") (vla-get-TextString obj))
                       (strcat (dcad-dinf-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dcad-dinf-label "Rotation") 
                               (rtos (dcad-dinf-toang (vla-get-Rotation obj) 1) 2 3)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-label "Style") (vla-get-StyleName obj))
                 )
       )
      )
      ((= name "BODY")
       (setq lst (list (dcad-dinf-t "TypeBody") 
                       laynm
                       (strcat (dcad-dinf-label "VersionNumber") (itoa (dcad-dinf-dxf ent 70)))
                 )
       )
      )
      ((= name "CIRCLE")
       (Setq Cen (VLAX-SafeArray->List (VLAX-Variant-Value (VLA-Get-Center obj))))
       (Setq Cen_x (car Cen))
       (setq Cen_y (nth 1 Cen))
       (setq lst (list (dcad-dinf-t "TypeCircle") 
                       laynm
                       (strcat (dcad-dinf-label "Radius") (rtos (vla-get-radius obj) 2 3))
                       (strcat (dcad-dinf-label "Diameter") (rtos (vla-get-diameter obj) 2 3))
                       (strcat (dcad-dinf-label "Circumference") 
                               (rtos (vla-get-Circumference obj) 2 3)
                       )
                       (strcat (dcad-dinf-label "Area") (rtos (/ (vla-get-Area obj)) 2 2) "  ")
                       (strcat (dcad-dinf-xprefix "Center") (rtos Cen_x))
                       (strcat "     Y=" (rtos Cen_y))
                 )
       )
      )
      ((= name "DIMENSION")
       (setq lst (list (dcad-dinf-t "TypeDimension") 
                       laynm
                       (strcat (dcad-dinf-label "DimStyle") (vla-get-StyleName obj))
                       (strcat (dcad-dinf-label "TextStyle") (vla-get-TextStyle obj))
                       (strcat (dcad-dinf-label "TextHeight") (rtos (vla-get-TextHeight obj) 2 3))
                       (strcat (dcad-dinf-label "TextOverride") 
                               (if (= (dcad-dinf-dxf ent 1) "") (dcad-dinf-t "None") (dcad-dinf-dxf ent 1))
                       )
                 )
       )
      )
      ((= name "ELLIPSE")
       (setq lst (list (dcad-dinf-t "TypeEllipse") 
                       laynm
                       (strcat (dcad-dinf-label "MajorRadius") 
                               (rtos (vla-get-MajorRadius obj) 2 3)
                       )
                       (strcat (dcad-dinf-label "MinorRadius") 
                               (rtos (vla-get-MinorRadius obj) 2 3)
                       )
                       (strcat (dcad-dinf-label "StartAngle") 
                               (rtos (dcad-dinf-toang (vla-get-StartAngle obj) 1) 2 3)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-label "EndAngle") 
                               (rtos (dcad-dinf-toang (vla-get-EndAngle obj) 1) 2 3)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-label "Area") (rtos (/ (vla-get-Area obj)) 2 4) "  ")
                 )
       )
      )
      ((= name "HATCH")
       (setq lst (list (dcad-dinf-t "TypeHatch") 
                       laynm
                       (strcat (dcad-dinf-label "Pattern") (vla-get-PatternName obj))
                       (strcat (dcad-dinf-label "Angle") 
                               (rtos (dcad-dinf-toang (vla-get-PatternAngle obj) 1) 2 1)
                       )
                       (strcat (dcad-dinf-label "Scale") (rtos (vla-get-PatternScale obj) 2 4))
                       (strcat (dcad-dinf-label "Associative") 
                               (if (= (vla-get-AssociativeHatch obj) :vlax-false) 
                                 (dcad-dinf-t "Off")
                                 (dcad-dinf-t "On")
                               )
                       )
                       (strcat (dcad-dinf-label "HatchStyle") 
                               (dcad-dinf-hatch-style (vla-get-HatchStyle obj))
                       )
                 )
       )
      )
      ((= name "IMAGE")
       (setq lst (list (dcad-dinf-t "TypeImage") 
                       laynm
                       (strcat (dcad-dinf-label "ImageSize") 
                               (rtos (car (dcad-dinf-dxf ent 13)) 2 0)
                               "X"
                               (rtos (cadr (dcad-dinf-dxf ent 13)) 2 0)
                       )
                 )
       )
       (strcat (dcad-dinf-label "ReferencePath") (vl-filename-base (dcad-dinf-dxf ent 1)))
      )
      ((= name "INSERT")
       (setq lst (list (dcad-dinf-t "TypeInsert") 
                       laynm
                       (strcat (dcad-dinf-label "BlockName") (dcad-dinf-dxf ent 2))
                       (strcat (dcad-dinf-label "ScaleX") (rtos (dcad-dinf-dxf ent 41) 2 1))
                       (strcat (dcad-dinf-label "ScaleY") (rtos (dcad-dinf-dxf ent 42) 2 1))
                       (strcat (dcad-dinf-label "ScaleZ") (rtos (dcad-dinf-dxf ent 43) 2 1))
                       (strcat (dcad-dinf-label "Rotation") 
                               (rtos (dcad-dinf-toang (vla-get-Rotation obj) 1) 2 1)
                               (dcad-dinf-t "DegreeUnit")
                       )
                 )
       )
      )
      ((= name "LEADER")
       (setq lst (list (dcad-dinf-t "TypeLeader") 
                       laynm
                       (strcat (dcad-dinf-label "Style") (vla-get-StyleName obj))
                       (strcat (dcad-dinf-label "CurveType") 
                               (dcad-dinf-curve-type (dcad-dinf-dxf ent 72))
                       )
                 )
       )
      )
      ((= name "LINE")
       (Setq Star (VLAX-SafeArray->List (VLAX-Variant-Value (VLA-Get-startpoint obj))))
       (Setq Star_x (car Star))
       (setq Star_y (nth 1 Star))
       (Setq End (VLAX-SafeArray->List (VLAX-Variant-Value (VLA-Get-endpoint obj))))
       (Setq End_x (car End))
       (setq End_y (nth 1 End))
       (setq lst (list (dcad-dinf-t "TypeLine") 
                       laynm
                       (strcat (dcad-dinf-label "Length") 
                               (rtos (vla-get-length obj) 2 4)
                               (strcat " " (dcad-dinf-label "Angle"))
                               (rtos (dcad-dinf-toang (vla-get-angle obj) 1) 2 3)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-xprefix "StartPoint") 
                               (rtos Star_x)
                               " Y="
                               (rtos Star_y)
                       )
                       (strcat (dcad-dinf-xprefix "EndPoint") (rtos End_x) " Y=" (rtos End_y))
                 )
       )
      )
      ((= name "LWPOLYLINE")
       (setq lst (list (dcad-dinf-t "TypeLwPolyline") 
                       laynm
                       (strcat (dcad-dinf-label "ConstantWidth") 
                               (if (dcad-dinf-dxf ent 43) 
                                 (rtos (vla-get-ConstantWidth obj) 2 4)
                                 (dcad-dinf-t "VariableWidth")
                               )
                       )
                       (strcat (dcad-dinf-label "Closed") 
                               (if (= (vla-get-Closed obj) :vlax-false) 
                                 (dcad-dinf-t "No")
                                 (dcad-dinf-t "Yes")
                               )
                       )
                       (strcat (dcad-dinf-label "Area") (rtos (/ (vla-get-Area obj)) 2 4) "  ")
                       (strcat (dcad-dinf-label "Length") 
                               (rtos (vla-get-length obj) 2 4)
                       )
                 )
       )
      )

      ((= name "MTEXT")
       (setq lst (list (dcad-dinf-t "TypeMText") 
                       laynm
                       (strcat (dcad-dinf-label "Content") (dcad-dinf-one-line (vla-get-TextString obj)))
                       (strcat (dcad-dinf-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dcad-dinf-label "Rotation") 
                               (rtos (dcad-dinf-toang (vla-get-Rotation obj) 1) 2 2)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-label "Style") (vla-get-StyleName obj))
                 )
       )
      )
      ((or (= name "OLEFRame") (= name "OLE2FRame"))
       (setq lst (list (dcad-dinf-t "TypeOleBorder") 
                       laynm
                       (strcat (dcad-dinf-label "VersionNumber") (itoa (dcad-dinf-dxf ent 70)))
                 )
       )
      )
      ((= name "POINT")
       (setq lst (list (dcad-dinf-t "TypePoint") laynm))
      )
      ((= name "POLYLINE")
       (setq lst (list (dcad-dinf-t "TypePolyline") laynm))
      )
      ((= name "RAY")
       (setq lst (list (dcad-dinf-t "TypeRay") laynm))
      )
      ; ((= name "REGION")
      ;)
      ((= name "REGION")
       (setq lst (list (dcad-dinf-t "TypeRegion") 
                       laynm
                       (strcat (dcad-dinf-label "Area") (rtos (vla-get-Area obj) 2 2))
                 )
       )
       (setq lst (list (dcad-dinf-t "TypeRegion") 
                       laynm
                       (strcat (dcad-dinf-label "VersionNumber") (itoa (dcad-dinf-dxf ent 70)))
                 )
       )
      )
      ((= name "SHAPE")
       (setq lst (list (dcad-dinf-t "TypeShape") 
                       laynm
                       (strcat (dcad-dinf-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dcad-dinf-label "Scale") 
                               (rtos (vla-get-ScaleFactor obj) 2 3)
                       )
                       (strcat (dcad-dinf-label "Rotation") 
                               (rtos (dcad-dinf-toang (vla-get-Rotation obj) 1) 2 4)
                               (dcad-dinf-t "DegreeUnit")
                       )
                 )
       )
      )
      ((= name "SOLID")
       (setq lst (list (dcad-dinf-t "TypeSolid") laynm))
      )
      ((= name "SPLINE")
       (setq lst (list (dcad-dinf-t "TypeSpline") 
                       laynm
                       (strcat (dcad-dinf-label "Closed") 
                               (if (= (vla-get-Closed obj) :vlax-false) (dcad-dinf-t "Off") (dcad-dinf-t "On"))
                       )
                       (strcat (dcad-dinf-label "Degree") (rtos (vla-get-Degree obj) 2 0))
                       (strcat (dcad-dinf-label "Area") (rtos (/ (vla-get-Area obj)) 2 2) "  ")
                 )
       )
      )
      ((= name "TEXT")
       (setq lst (list (dcad-dinf-t "TypeText") 
                       laynm
                       (strcat (dcad-dinf-label "Content") (vla-get-TextString obj))
                       (strcat (dcad-dinf-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dcad-dinf-label "Scale") 
                               (rtos (vla-get-ScaleFactor obj) 2 3)
                       )
                       (strcat (dcad-dinf-label "Rotation") 
                               (rtos (dcad-dinf-toang (vla-get-Rotation obj) 1) 2 4)
                               (dcad-dinf-t "DegreeUnit")
                       )
                       (strcat (dcad-dinf-label "Style") (vla-get-StyleName obj))
                       (strcat (dcad-dinf-label "Alignment") 
                               (dcad-dinf-alignment-name (vla-get-Alignment obj))
                       )
                 )
       )
      )
      ((= name "TOLERANCE")
       (setq lst (list (dcad-dinf-t "TypeTolerance") 
                       laynm
                       (strcat (dcad-dinf-label "Style") (vla-get-StyleName obj))
                       (strcat (dcad-dinf-label "TextStyle") (vla-get-TextStyle obj))
                       (strcat (dcad-dinf-label "TextHeight") 
                               (rtos (vla-get-TextHeight obj) 2 3)
                       )
                 )
       )
      )
      ((= name "TRACE")
       (setq lst (list (dcad-dinf-t "TypeTrace") laynm))
      )
      ((= name "XLINE")
       (setq lst (list (dcad-dinf-t "TypeXline") laynm))
      )
      (T
       (setq lst (list (dcad-dinf-t "TypeUnknown") laynm))
      )
    )
    (if (and lst (>= (length lst) 2) (dcad-dinf-dxf ent 5))
      (setq lst
        (append
          (list (car lst) (cadr lst)
                (strcat (dcad-dinf-label "LabelHandle") (dcad-dinf-dxf ent 5)))
          (cddr lst))))
    lst
  )

(setq *dcad-dinf-last-entity* nil)
(setq *dcad-dinf-last-info* nil)

(defun dcad-dinf-clear-highlight ()
  (if *dcad-dinf-last-entity*
    (vl-catch-all-apply 'redraw (list *dcad-dinf-last-entity* 4)))
  (setq *dcad-dinf-last-entity* nil
        *dcad-dinf-last-info* nil)
  nil
)

; A single reader/rollover highlighter shared by the native-pick and
; nentselp-fallback paths. No database modifications are performed.
(defun dcad-dinf-entity-info (ent / result kind layer handle)
  (cond
    ((not ent)
      (dcad-dinf-clear-highlight)
      nil)
    ((equal ent *dcad-dinf-last-entity*)
      *dcad-dinf-last-info*)
    (T
      (dcad-dinf-clear-highlight)
      (setq *dcad-dinf-last-entity* ent)
      (vl-catch-all-apply 'redraw (list ent 3))
      (setq result (vl-catch-all-apply 'dcad-dinf-dis (list ent)))
      (if (or (vl-catch-all-error-p result) (not result))
        (progn
          ; Some object types/proxies do not expose every ActiveX property.
          ; Report their actual DXF type/identity instead of a blank tooltip.
          (setq kind (dcad-dinf-dxf ent 0)
                layer (dcad-dinf-dxf ent 8)
                handle (dcad-dinf-dxf ent 5))
          (setq result
            (list
              (strcat (dcad-dinf-t "TypeUnknown") " [" (if kind kind "?") "]")
              (strcat (dcad-dinf-label "LabelLayer") (if layer layer ""))
              (strcat (dcad-dinf-label "LabelHandle") (if handle handle ""))))))
      (setq *dcad-dinf-last-info* result)
      result)
  )
)

(defun dcad-dinformation-getinfo-handle (handle / ent)
  (setq ent
    (if (and handle (= (type handle) 'STR))
      (vl-catch-all-apply 'handent (list handle))))
  (if (vl-catch-all-error-p ent) (setq ent nil))
  (dcad-dinf-entity-info ent)
)

(defun dcad-dinformation-getinfo (x y z / hit ent)
  (setq hit
    (vl-catch-all-apply
      'nentselp
      (list (trans (list x y z) 0 1))))
  (if (vl-catch-all-error-p hit)
    (setq hit nil))
  (setq ent
    (if (and hit
             (= (type (last (last hit))) 'ename))
      (last (last hit))
      (if hit (car hit) nil)))
  (dcad-dinf-entity-info ent)
)

(defun dcad-dinformation-reset ()
  (dcad-dinf-clear-highlight)
  T
)

(vl-acad-defun 'dcad-dinformation-getinfo)
(vl-acad-defun 'dcad-dinformation-getinfo-handle)
(vl-acad-defun 'dcad-dinformation-reset)

(setq *dcad-dinf-loaded* T)
