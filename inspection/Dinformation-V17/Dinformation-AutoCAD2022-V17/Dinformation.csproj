<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>DinformationC22</AssemblyName>
    <RootNamespace>DCAD.Dinformation</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\</OutputPath>
    <AutoCADTargetVersion>2022</AutoCADTargetVersion>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="icon\DcadLogo.ico">
      <LogicalName>DCAD.Dinformation.icon.DcadLogo.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="icon\DcadLogo.png" />
    <EmbeddedResource Include="Buildtime\Language\lang.dat"><LogicalName>DCAD.Dinformation.Buildtime.lang.dat</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Buildtime\Dinformation-Tooltip.lsp.tpl"><LogicalName>DCAD.Dinformation.Buildtime.Dinformation-Tooltip.lsp.tpl</LogicalName></EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AcCoreMgd">
      <HintPath>Reference\AcCoreMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcDbMgd">
      <HintPath>Reference\AcDbMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcMgd">
      <HintPath>Reference\AcMgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateBuildInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('Reference\AcCoreMgd.dll')" Text="Dinformation V17 AutoCAD 2022: missing Reference\AcCoreMgd.dll." />
    <Error Condition="!Exists('Reference\AcDbMgd.dll')" Text="Dinformation V17 AutoCAD 2022: missing Reference\AcDbMgd.dll." />
    <Error Condition="!Exists('Reference\AcMgd.dll')" Text="Dinformation V17 AutoCAD 2022: missing Reference\AcMgd.dll." />
  
    <Error Condition="!Exists('Buildtime\Language\lang.dat')" Text="Dinformation V17: missing Buildtime\Language\lang.dat." />
  <Error Condition="!Exists('Buildtime\Dinformation-Tooltip.lsp.tpl')" Text="Dinformation V17: missing embedded LISP tooltip engine template." />
  </Target>

  <Target Name="CleanFlatBinBeforeBuild" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <OldBinFiles Include="$(MSBuildProjectDirectory)\bin\*.*" />
    </ItemGroup>
    <Delete Files="@(OldBinFiles)" ContinueOnError="true" />
  </Target>

  <Target Name="KeepOnlyMainDllAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ExtraBinFiles Include="$(TargetDir)*.*" Exclude="$(TargetPath)" />
    </ItemGroup>
    <Delete Files="@(ExtraBinFiles)" ContinueOnError="true" />
  </Target>
</Project>
