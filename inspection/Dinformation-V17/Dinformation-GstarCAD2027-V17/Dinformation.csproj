<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <AssemblyName>DinformationG27</AssemblyName>
    <RootNamespace>DCAD.Dinformation</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\</OutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="icon\DcadLogo.ico"><LogicalName>DCAD.Dinformation.icon.DcadLogo.ico</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="icon\DcadLogo.png" />
    <EmbeddedResource Include="Buildtime\Language\lang.dat"><LogicalName>DCAD.Dinformation.Buildtime.lang.dat</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Buildtime\Dinformation-Tooltip.lsp.tpl"><LogicalName>DCAD.Dinformation.Buildtime.Dinformation-Tooltip.lsp.tpl</LogicalName></EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="GcCoreMgd"><HintPath>Reference\GcCoreMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="GcDbMgd"><HintPath>Reference\GcDbMgd.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="GcMgd"><HintPath>Reference\GcMgd.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateGstarCAD2027References" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('Reference\GcCoreMgd.dll')" Text="Dinformation GstarCAD 2027 V17: missing Reference\GcCoreMgd.dll." />
    <Error Condition="!Exists('Reference\GcDbMgd.dll')" Text="Dinformation GstarCAD 2027 V17: missing Reference\GcDbMgd.dll." />
    <Error Condition="!Exists('Reference\GcMgd.dll')" Text="Dinformation GstarCAD 2027 V17: missing Reference\GcMgd.dll." />
  
    <Error Condition="!Exists('Buildtime\Language\lang.dat')" Text="Dinformation V17: missing Buildtime\Language\lang.dat." />
  <Error Condition="!Exists('Buildtime\Dinformation-Tooltip.lsp.tpl')" Text="Dinformation V17: missing embedded LISP tooltip engine template." />
  </Target>
  <Target Name="CleanFlatBinBeforeBuild" BeforeTargets="PrepareForBuild"><ItemGroup><OldBinFiles Include="$(MSBuildProjectDirectory)\bin\*.*" /></ItemGroup><Delete Files="@(OldBinFiles)" ContinueOnError="true" /></Target>
  <Target Name="KeepOnlyMainDllAfterBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'"><ItemGroup><ExtraBinFiles Include="$(TargetDir)*.*" Exclude="$(TargetPath)" /></ItemGroup><Delete Files="@(ExtraBinFiles)" ContinueOnError="true" /></Target>
</Project>
