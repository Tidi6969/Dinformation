      )
      ((= name "ARC")
       (Setq Cen (VLAX-SafeArray->List (VLAX-Variant-Value (VLA-Get-Center obj))))
       (Setq arc_x (car Cen))
       (setq arc_y (nth 1 Cen))
       (setq lst (list (dinf18-t "TypeArc") 
                       laynm
                       (strcat (dinf18-label "Radius") (rtos (vla-get-radius obj) 2 4))
                       (strcat (dinf18-label "ArcAngle") 
                               (rtos (toang (vla-get-TotalAngle obj) 1) 2 3)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-label "StartAngle") 
                               (rtos (toang (vla-get-StartAngle obj) 1) 2 3)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-label "EndAngle") 
                               (rtos (toang (vla-get-EndAngle obj) 1) 2 3)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-label "ArcLength") 
                               (rtos (vla-get-ArcLength obj) 2 4)
                       )
                       (strcat (dinf18-label "Area") (rtos (/ (vla-get-area obj)) 2 3) "")
                       (strcat (dinf18-xprefix "Center") (rtos arc_x))
                       (strcat "     Y=" (rtos arc_y))
                 )
       )
      )
      ((= name "ATTDEF")
       (setq lst (list (dinf18-t "TypeAttributeDefinition") 
                       laynm
                       (strcat (dinf18-label "Tag") (vla-get-TagString obj))
                       (strcat (dinf18-label "Prompt") (vla-get-PromptString obj))
                       (strcat (dinf18-label "Default") (vla-get-TextString obj))
                       (strcat (dinf18-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dinf18-label "Rotation") 
                               (rtos (toang (vla-get-Rotation obj) 1) 2 3)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-label "Style") (vla-get-StyleName obj))
                 )
       )
      )
      ((= name "ATTRIB")
       (setq lst (list (dinf18-t "TypeAttribute") 
                       laynm
                       (strcat (dinf18-label "Tag") (vla-get-TagString obj))
                       (strcat (dinf18-label "Value") (vla-get-TextString obj))
                       (strcat (dinf18-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dinf18-label "Rotation") 
                               (rtos (toang (vla-get-Rotation obj) 1) 2 3)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-label "Style") (vla-get-StyleName obj))
                 )
       )
      )
      ((= name "BODY")
       (setq lst (list (dinf18-t "TypeBody") 
                       laynm
                       (strcat (dinf18-label "VersionNumber") (itoa (dxf ent 70)))
                 )
       )
      )
      ((= name "CIRCLE")
       (Setq Cen (VLAX-SafeArray->List (VLAX-Variant-Value (VLA-Get-Center obj))))
       (Setq Cen_x (car Cen))
       (setq Cen_y (nth 1 Cen))
       (setq lst (list (dinf18-t "TypeCircle") 
                       laynm
                       (strcat (dinf18-label "Radius") (rtos (vla-get-radius obj) 2 3))
                       (strcat (dinf18-label "Diameter") (rtos (vla-get-diameter obj) 2 3))
                       (strcat (dinf18-label "Circumference") 
                               (rtos (vla-get-Circumference obj) 2 3)
                       )
                       (strcat (dinf18-label "Area") (rtos (/ (vla-get-Area obj)) 2 2) "  ")
                       (strcat (dinf18-xprefix "Center") (rtos Cen_x))
                       (strcat "     Y=" (rtos Cen_y))
                 )
       )
      )
      ((= name "DIMENSION")
       (setq lst (list (dinf18-t "TypeDimension") 
                       laynm
                       (strcat (dinf18-label "DimStyle") (vla-get-StyleName obj))
                       (strcat (dinf18-label "TextStyle") (vla-get-TextStyle obj))
                       (strcat (dinf18-label "TextHeight") (rtos (vla-get-TextHeight obj) 2 3))
                       (strcat (dinf18-label "TextOverride") 
                               (if (= (dxf ent 1) "") (dinf18-t "None") (dxf ent 1))
                       )
                 )
       )
      )
      ((= name "ELLIPSE")
       (setq lst (list (dinf18-t "TypeEllipse") 
                       laynm
                       (strcat (dinf18-label "MajorRadius") 
                               (rtos (vla-get-MajorRadius obj) 2 3)
                       )
                       (strcat (dinf18-label "MinorRadius") 
                               (rtos (vla-get-MinorRadius obj) 2 3)
                       )
                       (strcat (dinf18-label "StartAngle") 
                               (rtos (toang (vla-get-StartAngle obj) 1) 2 3)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-label "EndAngle") 
                               (rtos (toang (vla-get-EndAngle obj) 1) 2 3)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-label "Area") (rtos (/ (vla-get-Area obj)) 2 4) "  ")
                 )
       )
      )
      ((= name "HATCH")
       (setq lst (list (dinf18-t "TypeHatch") 
                       laynm
                       (strcat (dinf18-label "Pattern") (vla-get-PatternName obj))
                       (strcat (dinf18-label "Angle") 
                               (rtos (toang (vla-get-PatternAngle obj) 1) 2 1)
                       )
                       (strcat (dinf18-label "Scale") (rtos (vla-get-PatternScale obj) 2 4))
                       (strcat (dinf18-label "Associative") 
                               (if (= (vla-get-AssociativeHatch obj) :vlax-false) 
                                 (dinf18-t "Off")
                                 (dinf18-t "On")
                               )
                       )
                       (strcat (dinf18-label "HatchStyle") 
                               (dinf18-hatch-style (vla-get-HatchStyle obj))
                       )
                 )
       )
      )
      ((= name "IMAGE")
       (setq lst (list (dinf18-t "TypeImage") 
                       laynm
                       (strcat (dinf18-label "ImageSize") 
                               (rtos (car (dxf ent 13)) 2 0)
                               "X"
                               (rtos (cadr (dxf ent 13)) 2 0)
                       )
                 )
       )
       (strcat (dinf18-label "ReferencePath") (vl-filename-base (dxf ent 1)))
      )
      ((= name "INSERT")
       (setq lst (list (dinf18-t "TypeInsert") 
                       laynm
                       (strcat (dinf18-label "BlockName") (dxf ent 2))
                       (strcat (dinf18-label "ScaleX") (rtos (dxf ent 41) 2 1))
                       (strcat (dinf18-label "ScaleY") (rtos (dxf ent 42) 2 1))
                       (strcat (dinf18-label "ScaleZ") (rtos (dxf ent 43) 2 1))
                       (strcat (dinf18-label "Rotation") 
                               (rtos (toang (vla-get-Rotation obj) 1) 2 1)
                               (dinf18-t "DegreeUnit")
                       )
                 )
       )
      )
      ((= name "LEADER")
       (setq lst (list (dinf18-t "TypeLeader") 
                       laynm
                       (strcat (dinf18-label "Style") (vla-get-StyleName obj))
                       (strcat (dinf18-label "CurveType") 
                               (dinf18-curve-type (dxf ent 72))
                       )
                 )
       )
      )
      ((= name "LINE")
       (Setq Star (VLAX-SafeArray->List (VLAX-Variant-Value (VLA-Get-startpoint obj))))
       (Setq Star_x (car Star))
       (setq Star_y (nth 1 Star))
       (Setq End (VLAX-SafeArray->List (VLAX-Variant-Value (VLA-Get-endpoint obj))))
       (Setq End_x (car End))
       (setq End_y (nth 1 End))
       (setq lst (list (dinf18-t "TypeLine") 
                       laynm
                       (strcat (dinf18-label "Length") 
                               (rtos (vla-get-length obj) 2 4)
                               (strcat " " (dinf18-label "Angle"))
                               (rtos (toang (vla-get-angle obj) 1) 2 3)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-xprefix "StartPoint") 
                               (rtos Star_x)
                               " Y="
                               (rtos Star_y)
                       )
                       (strcat (dinf18-xprefix "EndPoint") (rtos End_x) " Y=" (rtos End_y))
                 )
       )
      )
      ((= name "LWPOLYLINE")
       (setq lst (list (dinf18-t "TypeLwPolyline") 
                       laynm
                       (strcat (dinf18-label "ConstantWidth") 
                               (if (dxf ent 43) 
                                 (rtos (vla-get-ConstantWidth obj) 2 4)
                                 (dinf18-t "VariableWidth")
                               )
                       )
                       (strcat (dinf18-label "Closed") 
                               (if (= (vla-get-Closed obj) :vlax-false) 
                                 (dinf18-t "No")
                                 (dinf18-t "Yes")
                               )
                       )
                       (strcat (dinf18-label "Area") (rtos (/ (vla-get-Area obj)) 2 4) "  ")
                       (strcat (dinf18-label "Length") 
                               (rtos (vla-get-length obj) 2 4)
                       )
                 )
       )
      )

      ((= name "MTEXT")
       (setq lst (list (dinf18-t "TypeMText") 
                       laynm
                       (strcat (dinf18-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dinf18-label "Rotation") 
                               (rtos (toang (vla-get-Rotation obj) 1) 2 2)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-label "Style") (vla-get-StyleName obj))
                 )
       )
      )
      ((or (= name "OLEFRame") (= name "OLE2FRame"))
       (setq lst (list (dinf18-t "TypeOleBorder") 
                       laynm
                       (strcat (dinf18-label "VersionNumber") (itoa (dxf ent 70)))
                 )
       )
      )
      ((= name "POINT")
       (setq lst (list (dinf18-t "TypePoint") laynm))
      )
      ((= name "POLYLINE")
       (setq lst (list (dinf18-t "TypePolyline") laynm))
      )
      ((= name "RAY")
       (setq lst (list (dinf18-t "TypeRay") laynm))
      )
      ; ((= name "REGION")
      ;)
      ((= name "REGION")
       (setq lst (list (dinf18-t "TypeRegion") 
                       laynm
                       (strcat (dinf18-label "Area") (rtos (vla-get-Area obj) 2 2))
                 )
       )
       (setq lst (list (dinf18-t "TypeRegion") 
                       laynm
                       (strcat (dinf18-label "VersionNumber") (itoa (dxf ent 70)))
                 )
       )
      )
      ((= name "SHAPE")
       (setq lst (list (dinf18-t "TypeShape") 
                       laynm
                       (strcat (dinf18-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dinf18-label "Scale") 
                               (rtos (vla-get-ScaleFactor obj) 2 3)
                       )
                       (strcat (dinf18-label "Rotation") 
                               (rtos (toang (vla-get-Rotation obj) 1) 2 4)
                               (dinf18-t "DegreeUnit")
                       )
                 )
       )
      )
      ((= name "SOLID")
       (setq lst (list (dinf18-t "TypeSolid") laynm))
      )
      ((= name "SPLINE")
