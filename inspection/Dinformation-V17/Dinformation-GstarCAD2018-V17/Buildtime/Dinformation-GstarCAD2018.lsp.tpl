; Dinformation GstarCAD 2018 temporary LISP engine - ASCII source only.
; Generated by Dinformation.dll. The file deletes itself when dinf18-run starts.

@@BOOTSTRAP@@

(defun dinf18-t (key / pair)
  (setq pair (assoc key *dinf18-lang*))
  (if pair (cdr pair) key)
)

(defun dinf18-label (key) (strcat (dinf18-t key) ": "))
(defun dinf18-xprefix (key) (strcat (dinf18-t key) ": X="))

(defun dinf18-hatch-style (idx)
  (nth idx (list (dinf18-t "HatchNormal") (dinf18-t "HatchOuter") (dinf18-t "HatchIgnore")))
)

(defun dinf18-curve-type (idx)
  (if (= idx 1) (dinf18-t "WordSpline") (dinf18-t "WordPolyline"))
)

(defun dinf18-alignment-name (idx)
  (nth idx
    (list
      (dinf18-t "AlignLeft") (dinf18-t "AlignCenter") (dinf18-t "AlignRight")
      (dinf18-t "AlignAligned") (dinf18-t "AlignMiddle") (dinf18-t "AlignFit")
      (dinf18-t "AlignTopLeft") (dinf18-t "AlignTopCenter") (dinf18-t "AlignTopRight")
      (dinf18-t "AlignMiddleLeft") (dinf18-t "AlignMiddleCenter") (dinf18-t "AlignMiddleRight")
      (dinf18-t "AlignBottomLeft") (dinf18-t "AlignBottomCenter") (dinf18-t "AlignBottomRight")
    )
  )
)

(defun dinf18-run (/ myerr dxf toang fx dinf18-wcs dinf18-ucs-angle dinf18-text-height
             dinf18-display-len dinf18-erase-ss dinf18-cleanup add_solid add_text dis
             olderr oldos oldfill oldcmdecho ss pd gr pt ent entold ptdcs
            ) 
  (vl-load-com)
  (if (and *dinf18-temp-file* (findfile *dinf18-temp-file*))
    (vl-file-delete *dinf18-temp-file*)
  )
  (defun myerr (msg)
    (dinf18-cleanup)
    (princ)
  )
  (defun dxf (ent i) 
    (if (= (type ent) 'ename) 
      (setq ent (entget ent))
    )
    (cdr (assoc i ent))
  )
  (defun toang (ang i) 
    (if (= i 1) 
      (* ang (/ 180 pi))
      (* ang (/ pi 180))
    )
  )
  (defun fx (ang) 
    (cond 
      ((>= (/ pi 2) ang 0) (list pi (+ pi (/ pi 2)) 1))
      ((>= pi ang (/ pi 2)) (list 0 (+ pi (/ pi 2)) 1))
      ((>= (+ pi (/ pi 2)) ang pi) (list 0 (/ pi 2) 0))
      ((>= (* 2 pi) ang (+ pi (/ pi 2))) (list pi (/ pi 2) 0))
    )
  )
  ; Overlay coordinates are authored in the current UCS and converted to WCS
  ; only when the temporary entities are created. This avoids changing UCS/view.
  (defun dinf18-wcs (p) (trans p 1 0))

  (defun dinf18-ucs-angle (/ vx)
    (setq vx (trans '(1.0 0.0 0.0) 1 0 T))
    (atan (cadr vx) (car vx))
  )

  ; Keep the text approximately 18 screen pixels high regardless of zoom.
  ; If SCREENSIZE is unavailable/invalid, fall back to the legacy ratio.
  (defun dinf18-text-height (/ vs scr sh)
    (setq vs (getvar "VIEWSIZE")
          scr (getvar "SCREENSIZE")
          sh (if (and (listp scr) (> (length scr) 1)) (cadr scr) 0)
    )
    (if (and sh (> sh 0))
      (* (/ vs sh) 18.0)
      (/ vs 50.0)
    )
  )

  ; GstarCAD 2018 receives non-ASCII text as CAD escapes such as \U+00EA.
  ; Count each complete \U+XXXX sequence as one displayed character so the
  ; background width is not inflated by the seven ASCII source characters.
  (defun dinf18-display-len (s / i l n)
    (setq i 1 l (strlen s) n 0)
    (while (<= i l)
      (if (and (<= (+ i 6) l)
               (= (substr s i 1) "\\")
               (= (strcase (substr s (+ i 1) 1)) "U")
               (= (substr s (+ i 2) 1) "+"))
        (setq i (+ i 7))
        (setq i (1+ i))
      )
      (setq n (1+ n))
    )
    n
  )

  (defun dinf18-erase-ss (set / i en)
    (if set
      (progn
        (setq i 0)
        (repeat (sslength set)
          (setq en (ssname set i))
          (if en (entdel en))
          (setq i (1+ i))
        )
      )
    )
  )

  (defun dinf18-cleanup ()
    (if entold (redraw entold 4))
    (dinf18-erase-ss ss)
    (if oldos (setvar "OSMODE" oldos))
    (if oldfill (setvar "FILLMODE" oldfill))
    (if oldcmdecho (setvar "CMDECHO" oldcmdecho))
    (setq *error* olderr)
  )

  (defun add_solid (p1 p2 p3 p4)
    (entmakex
      (list (cons 0 "SOLID")
            (cons 100 "AcDbEntity")
            (cons 62 1)
            (cons 100 "AcDbTrace")
            (cons 10 (dinf18-wcs p1))
            (cons 11 (dinf18-wcs p2))
            (cons 12 (dinf18-wcs p3))
            (cons 13 (dinf18-wcs p4))
      )
    )
  )

  (defun add_text (pt h ang txt style jus / wp rot)
    (setq wp (dinf18-wcs pt)
          rot (+ ang (dinf18-ucs-angle)))
    (entmakex
      (list (cons 0 "TEXT")
            (cons 100 "AcDbEntity")
            (cons 62 2)
            (cons 100 "AcDbText")
            (if (= jus 0) (cons 10 wp) (list 10 0.0 0.0 0.0))
            (cons 40 h)
            (cons 1 txt)
            (cons 50 rot)
            (cons 7 style)
            (cons 72
                  (cond ((= jus 0) 0) ((= jus 1) 1) ((= jus 2) 1) ((= jus 3) 2))
            )
            (if (= jus 0)
              (list 11 0.0 0.0 0.0)
              (cons 11 wp)
            )
            (cons 100 "AcDbText")
            (cons 73
                  (cond ((= jus 0) 0) ((= jus 1) 2) ((= jus 2) 3) ((= jus 3) 2))
            )
      )
    )
  )
  (defun dis (ent / obj laynm name st1 st2 st3 lst h ang n) 
