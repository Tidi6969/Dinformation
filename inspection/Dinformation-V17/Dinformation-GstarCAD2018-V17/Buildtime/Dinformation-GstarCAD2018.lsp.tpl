                               (if (= (vla-get-Closed obj) :vlax-false) (dinf18-t "Off") (dinf18-t "On"))
                       )
                       (strcat (dinf18-label "Degree") (rtos (vla-get-Degree obj) 2 0))
                       (strcat (dinf18-label "Area") (rtos (/ (vla-get-Area obj)) 2 2) "  ")
                 )
       )
      )
      ((= name "TEXT")
       (setq lst (list (dinf18-t "TypeText") 
                       laynm
                       (strcat (dinf18-label "Content") (vla-get-TextString obj))
                       (strcat (dinf18-label "Height") (rtos (vla-get-Height obj) 2 3))
                       (strcat (dinf18-label "Scale") 
                               (rtos (vla-get-ScaleFactor obj) 2 3)
                       )
                       (strcat (dinf18-label "Rotation") 
                               (rtos (toang (vla-get-Rotation obj) 1) 2 4)
                               (dinf18-t "DegreeUnit")
                       )
                       (strcat (dinf18-label "Style") (vla-get-StyleName obj))
                       (strcat (dinf18-label "Alignment") 
                               (dinf18-alignment-name (vla-get-Alignment obj))
                       )
                 )
