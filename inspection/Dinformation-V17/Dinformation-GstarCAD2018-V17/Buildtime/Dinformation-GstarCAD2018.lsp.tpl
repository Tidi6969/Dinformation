      ((= name "TOLERANCE")
       (setq lst (list (dinf18-t "TypeTolerance") 
                       laynm
                       (strcat (dinf18-label "Style") (vla-get-StyleName obj))
                       (strcat (dinf18-label "TextStyle") (vla-get-TextStyle obj))
                       (strcat (dinf18-label "TextHeight") 
                               (rtos (vla-get-TextHeight obj) 2 3)
                       )
                 )
       )
      )
      ((= name "TRACE")
       (setq lst (list (dinf18-t "TypeTrace") laynm))
      )
      ((= name "XLINE")
       (setq lst (list (dinf18-t "TypeXline") laynm))
      )
      (T
       (setq lst (list (dinf18-t "TypeUnknown") laynm))
      )
    )
    (setq ss (ssadd)
          h  (dinf18-text-height)
          ptdcs (trans pt 1 2)
    )
    (setq ang (fx (angle (getvar "VIEWCTR") ptdcs)))
    (setq n (* 1.4 (1+ (/ (apply 'max (mapcar 'dinf18-display-len lst)) 2.0))))
    (ssadd 
      (add_solid 
        pt
        (polar pt (car ang) (* n h))
        (setq pt (polar pt (cadr ang) (+ h (* 1.8 h (length lst)))))
        (polar pt (car ang) (* n h))
      )
      ss
    )
    (setq pt (polar pt (car ang) (/ (* n h) 2)))
    (if (= (caddr ang) 0) 
      (setq pt (polar pt (/ pi 2) (* 0.4 h)))
      (setq pt (polar pt (/ pi 2) (+ (* 1.4 h) (* 1.8 h (length lst)))))
    )
    (setq n -1)
    (repeat (length lst) 
      (ssadd 
        (add_text 
          (setq pt (polar pt (+ pi (/ pi 2)) (* 1.8 h)))
          h
          0
          (nth (setq n (1+ n)) lst)
          *dinf18-style*
          1
        )
        ss
      )
    )
  )
  (vl-load-com)
  (prompt (strcat "\n***" (dinf18-t "StartPrompt")))
  (setq olderr *error*
        *error* myerr
        oldos (getvar "OSMODE")
        oldfill (getvar "FILLMODE")
        oldcmdecho (getvar "CMDECHO")
  )
  (setvar "OSMODE" 0)
  (setvar "FILLMODE" 1)
  (setvar "CMDECHO" 0)
  (if (not (tblsearch "style" *dinf18-style*)) 
    (command "-STYLE" *dinf18-style* *dinf18-font* "" "0.8" "" "" "")
  )
  (setq ss (ssadd))
  (while (not pd) 
    (while 
      (not 
        (progn 
          (setq gr (grread T 1))
          (if (= (car gr) 5) 
            (setq pt  (cadr gr)
                  ent (nentselp pt)
                  ent (if (and ent (= (type (last (last ent))) 'ename)) 
                        (last (last ent))
                        (car ent)
                      )
            )
            (setq pd T)
          )
        )
      )
    )
    (if (and (not pd) (not (equal ent entold)) (not (ssmemb ent ss))) 
      (progn 
        (if entold (redraw entold 4))
        (dinf18-erase-ss ss)
        (redraw ent 3)
        (dis ent)
        (setq entold ent)
      )
    )
  )
  (dinf18-cleanup)
  (princ)
)
